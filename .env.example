# Copier ce fichier en .env.local (non versionné) et renseigner les valeurs.
# Seules des valeurs PUBLIQUES vont ici : tout ce qui commence par VITE_ est envoyé au navigateur.
# Ne jamais mettre la clé service_role ni une clé secrète (sb_secret_...).

# Supabase > Project Settings > API
VITE_SUPABASE_URL=https://VOTRE-PROJET.supabase.co
# Clé publishable (sb_publishable_...), conçue pour être exposée au navigateur.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
